{
  "expo": {
    "name": "Studyzie School Supplies",
    "slug": "studyzie-school-supplies",
    "scheme": "studyzie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./screens/assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./screens/assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.studyzie.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "com.googleusercontent.apps.389416302400-kbkq1su4lo0gp35gutlrha4mq5f4mbgv"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./screens/assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./screens/assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "@react-native-google-signin/google-signin",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "f7e36831-61ac-435c-8932-85ec9d546fd4"
      }
    },
    "owner": "nerdy1213"
  }
}
